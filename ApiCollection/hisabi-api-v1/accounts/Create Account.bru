meta {
  name: Create Account
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/accounts
  body: json
}

headers {
  Authorization: Bearer {{token}}
  content-type: application/json
}

body:json {
  {
    "name": {
      "en": "Emergency Fund",
      "ar": "صندوق الطوارئ"
    },
    "balance": 1250.75
  }
}

script:post-response {
  if (res.status === 201 && res.body.account) {
    bru.setEnvVar("accountId", res.body.account.id, { persist: true });
  }
}

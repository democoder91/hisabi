meta {
  name: Share Account
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/accounts/{{accountId}}/shares
  body: json
}

headers {
  Authorization: Bearer {{token}}
  content-type: application/json
}

body:json {
  {
    "email": "{{shareUserEmail}}",
    "permission_level": "VIEW"
  }
}

script:post-response {
  if (res.status === 200 && res.body.account && Array.isArray(res.body.account.sharedUsers) && res.body.account.sharedUsers.length > 0) {
    bru.setEnvVar("shareUserId", res.body.account.sharedUsers[0].id, { persist: true });
  }
}
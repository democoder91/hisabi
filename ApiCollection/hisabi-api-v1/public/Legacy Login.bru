meta {
  name: Legacy Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{authEmail}}",
    "password": "{{authPassword}}",
    "device_name": "{{deviceName}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("token", res.body.token, { persist: true });
  }
}
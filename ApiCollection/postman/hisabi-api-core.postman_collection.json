                                    "const body = pm.response.json();",
                                    "if (pm.response.code === 201 && Array.isArray(body.data) && body.data.length > 0) {",
                                    "    pm.environment.set('smsId', body.data[0].id);",
                                    "    if (body.data[0].transaction_id) {",
                                    "        pm.environment.set('transactionId', body.data[0].transaction_id);",
                                    "    }",
                                    "}"
